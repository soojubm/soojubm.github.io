{
  "name": "soojubm",
  "version": "1.0.0",
  "scripts": {
    "postinstall": "npm run manifest",
    "predev": "npm run manifest",
    "dev": "webpack-dev-server --open",
    "prestart": "npm run manifest",
    "start": "webpack serve --open --mode=development",
    "build": "npm run manifest && webpack --mode=production && node scripts/copy-static-assets.mjs && node scripts/build-search-index.mjs",
    "manifest": "node scripts/build-component-manifest.mjs",
    "remove": "rm -r node_modules",
    "stat": "npx webpack --mode production --json artifacts/webpack-stats.json",
    "lint": "eslint \"{src,scripts}/**/*.{js,mjs,ts}\" index.ts webpack.config.js",
    "typecheck": "tsc --noEmit",
    "check:docs": "node scripts/check-docs.mjs",
    "lint:css": "stylelint \"src/**/*.css\" \"src/**/*.ts\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soojubm/soojubm.github.io.git"
  },
  "keywords": [
    "portfolio"
  ],
  "author": "soojubm",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/soojubm/soojubm.github.io/issues"
  },
  "homepage": "https://github.com/soojubm/soojubm.github.io#readme",
  "devDependencies": {
    "@types/prismjs": "^1.26.6",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "css-loader": "^6.7.2",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-lit": "^2.3.1",
    "eslint-plugin-lit-a11y": "^4.1.4",
    "eslint-plugin-wc": "^3.1.0",
    "html-loader": "^4.2.0",
    "html-webpack-plugin": "^5.6.7",
    "mini-css-extract-plugin": "^2.10.2",
    "pagefind": "^1.5.2",
    "postcss": "^8.5.15",
    "postcss-lit": "^1.4.1",
    "prettier": "^2.8.8",
    "stylelint": "^16.26.1",
    "ts-loader": "^9.6.0",
    "ts-node": "^10.9.2",
    "typescript": "^4.9.5",
    "webpack": "^5.107.2",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.4"
  },
  "dependencies": {
    "lit": "^3.3.2",
    "prismjs": "^1.30.0"
  },
  "overrides": {
    "sockjs": {
      "uuid": "^11.1.1"
    },
    "http-proxy-middleware": "^3.0.6",
    "minimatch": "^10.0.3",
    "brace-expansion": "^5.0.9"
  }
}
